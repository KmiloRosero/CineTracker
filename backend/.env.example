# Copy this file to backend/.env and fill in your keys.
# backend/.env is gitignored; never commit real keys.

# TMDB API key (v3 auth). Used for search, details and trending.
# Get one at https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# AI features (optional): recommendations, Descubrir lists, tonight picker,
# describe-to-find, cinephile profile, year in review and title insight.
# Gemini is used when its key is set, otherwise Claude; with neither, every
# feature falls back to rules.

# Google Gemini API key. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Gemini model (optional). Defaults to gemini-3.8-flash.
GEMINI_MODEL=

# Anthropic API key, used only when GEMINI_API_KEY is empty.
# Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=
# Claude model (optional). Defaults to claude-opus-5-5.
CLAUDE_MODEL=
