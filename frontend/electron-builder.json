{
  "appId": "com.cinetracker.app",
  "productName": "CineTracker",
  "copyright": "Copyright © 2026 Camilo Rosero",
  "directories": {
    "buildResources": "icons",
    "output": "C:/CineTracker-release"
  },
  "files": [
    "dist/**/*",
    "electron/**/*",
    "node_modules/**/*",
    "package.json",
    {
      "from": "../backend",
      "to": "backend",
      "filter": [
        "**/*",
        "!tests/**",
        "!.env.example"
      ]
    }
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      },
      {
        "target": "portable",
        "arch": [
          "x64"
        ]
      }
    ],
    "icon": "icons/icon.ico",
    "sign": null,
    "signingHashAlgorithms": null
  },
  "mac": {
    "target": [
      {
        "target": "dmg",
        "arch": [
          "x64",
          "arm64"
        ]
      }
    ],
    "icon": "icons/icon.icns",
    "category": "public.app-category.entertainment",
    "identity": null
  },
  "linux": {
    "target": [
      "AppImage"
    ],
    "icon": "icons/icon.png",
    "category": "Video"
  },
  "nsis": {
    "oneClick": false,
    "language": "3082",
    "installerLanguages": ["es_ES"],
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "shortcutName": "CineTracker",
    "artifactName": "CineTracker-Setup-${version}.${ext}"
  },
  "publish": null,
  "portable": {
    "artifactName": "CineTracker-Portable-${version}.${ext}"
  }
}
