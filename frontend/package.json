{
  "name": "cinetracker",
  "version": "1.1.1",
  "description": "Aplicación de escritorio para seguir y calificar películas y series.",
  "author": "Camilo Rosero",
  "license": "MIT",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"npm run dev:vite\" \"npm run dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .",
    "test": "cross-env ELECTRON_RUN_AS_NODE=1 electron ./node_modules/vitest/vitest.mjs run",
    "typecheck": "tsc --noEmit -p .",
    "test:watch": "cross-env ELECTRON_RUN_AS_NODE=1 electron ./node_modules/vitest/vitest.mjs",
    "build": "vite build",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win",
    "dist:win:public": "npm run build && node scripts/public-env.cjs && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win -c electron-builder.public.js",
    "dist:win:nokeys": "npm run build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win -c electron-builder.nokeys.js",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux",
    "postinstall": "electron-rebuild -f -w better-sqlite3"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^9.6.0"
  },
  "devDependencies": {
    "@fontsource/anton": "^5.2.5",
    "@fontsource/barlow": "^5.2.5",
    "@fontsource/barlow-condensed": "^5.2.5",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.20",
    "clsx": "^2.1.1",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^29.4.6",
    "electron-builder": "^24.13.3",
    "electron-rebuild": "^3.2.9",
    "framer-motion": "^14.0.0",
    "jsdom": "^25.0.1",
    "lucide-react": "^0.468.0",
    "postcss": "^8.4.49",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.3",
    "recharts": "^2.15.4",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3",
    "vite": "^5.2.0",
    "vitest": "^2.1.9",
    "wait-on": "^7.2.0"
  }
}
